{
    "name": "timmonaghan/laravel-security-agent",
    "description": "AI-powered security agent for Laravel — monitors logs and responds to threats via Claude.",
    "type": "library",
    "license": "MIT",
    "require-dev": {
        "phpunit/phpunit": "^10.0"
    },
    "autoload-dev": {
        "psr-4": {
            "Timmonaghan\\SecurityAgent\\Tests\\": "tests/"
        }
    },
    "require": {
        "php": "^8.1",
        "illuminate/support": "^8.0|^9.0|^10.0|^11.0|^12.0",
        "illuminate/console": "^8.0|^9.0|^10.0|^11.0|^12.0",
        "illuminate/database": "^8.0|^9.0|^10.0|^11.0|^12.0",
        "illuminate/queue": "^8.0|^9.0|^10.0|^11.0|^12.0",
        "illuminate/mail": "^8.0|^9.0|^10.0|^11.0|^12.0",
        "guzzlehttp/guzzle": "^7.0"
    },
    "autoload": {
        "psr-4": {
            "Timmonaghan\\SecurityAgent\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Timmonaghan\\SecurityAgent\\SecurityAgentServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
